# Copy to .env and adjust. All values have sensible defaults in config.py.

# Base URL of the application under test (no trailing slash).
BASE_URL=https://qae-assignment-tau.vercel.app

# The user-id used for authentication. The app sends this verbatim as the
# `x-user-id` header. The API validates it against an allowlist of issued IDs,
# so use the user-id you were assigned for the assignment.
USER_ID=candidate-pGM9TBT3AEsq

# Run Chrome headless (true in CI, false to watch locally).
HEADLESS=true

# Per-request / explicit-wait timeout in seconds.
TIMEOUT=15
